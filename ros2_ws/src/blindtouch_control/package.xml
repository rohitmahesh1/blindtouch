<?xml version="1.0"?>
<package format="3">
  <name>blindtouch_control</name>
  <version>0.1.0</version>
  <description>Controller, policy, and safety nodes for BlindTouch ROS loops.</description>
  <maintainer email="maintainers@example.com">BlindTouch Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>blindtouch_interfaces</exec_depend>
  <exec_depend>blindtouch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <depend>rclcpp</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
