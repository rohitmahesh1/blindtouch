%%{init: {"theme": "base", "themeVariables": {"background": "#fbfdff", "primaryColor": "#ffffff", "primaryTextColor": "#102a43", "primaryBorderColor": "#4f7fde", "lineColor": "#5f7898", "clusterBkg": "#ffffff", "clusterBorder": "#bed4f7", "edgeLabelBackground": "#fbfdff", "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif", "fontSize": "16px"}, "flowchart": {"curve": "basis", "padding": 30, "nodeSpacing": 50, "rankSpacing": 60}}}%%
flowchart TB
    Episode["BlindTouch Best Model<br/>Hierarchical BC + tactile safety"]

    subgraph World["1. Physical Scene"]
        direction LR
        Object["Unknown Object<br/>randomized pose, mass<br/>friction, safe force"]
        Claw["Three-Finger Claw<br/>27 fingertip taxels<br/>joint proprioception"]
        Contact["MuJoCo Contact<br/>pressure, slip, tilt<br/>damage checks"]
        Object --> Contact
        Claw --> Contact
    end

    subgraph Sensing["2. Touch-Only State"]
        direction LR
        Taxels["Taxel Pressure<br/>3 fingers x 9 cells"]
        Proprio["Proprioception<br/>joint state and effort"]
        Observation["Observation Vector<br/>no camera input<br/>no object label"]
        History["History Stack<br/>short tactile memory"]
        Taxels --> Observation
        Proprio --> Observation
        Observation --> History
    end

    subgraph PolicyBlock["3. Best Current Policy"]
        direction LR
        BestModel["Hierarchical BC Policy<br/>trained from successful<br/>touch trajectories"]
        Mode["Touch Mode Head<br/>probe, stabilize<br/>lift, release"]
        Heads["Mode-Conditioned Action<br/>finger closure<br/>and palm lift"]
        Safety["Tactile Safety Filter<br/>caps force spikes<br/>protects fragile cases"]
        Action["Motor Command<br/>applied next step"]
        BestModel --> Mode
        Mode --> Heads
        Heads --> Safety
        Safety --> Action
    end

    subgraph Training["4. Training And Selection"]
        direction LR
        Teachers["Skill Teachers<br/>generate candidate<br/>successful rollouts"]
        Store["Balanced Trajectory Store<br/>procedural objects<br/>and difficult cases"]
        HBC["Selected HBC Checkpoint<br/>offline imitation model"]
        Eval["Locked Evaluation<br/>safe success, peak force<br/>slip, damage, drops"]
        Teachers --> Store
        Store --> HBC
        HBC --> Eval
    end

    Episode --> Object
    Contact --> Taxels
    Contact --> Proprio
    History --> BestModel
    Action --> Contact
    Contact --> Eval
    HBC --> BestModel

    classDef title fill:#dbeafe,stroke:#2f6fd6,color:#102a43,stroke-width:3px,font-size:20px,font-weight:bold;
    classDef world fill:#fff7ed,stroke:#f59e0b,color:#3b2a12,stroke-width:2px,font-size:14px;
    classDef sense fill:#eff6ff,stroke:#3b82f6,color:#17324d,stroke-width:2px,font-size:14px;
    classDef policy fill:#f5f0ff,stroke:#8b5cf6,color:#2f1d57,stroke-width:2px,font-size:14px;
    classDef safety fill:#ecfdf5,stroke:#10b981,color:#123f2e,stroke-width:2px,font-size:14px;
    classDef learning fill:#f7fee7,stroke:#84cc16,color:#263a0a,stroke-width:2px,font-size:14px;
    classDef action fill:#fff1f2,stroke:#fb7185,color:#4a1720,stroke-width:2px,font-size:14px;

    class Episode title;
    class Object,Claw,Contact world;
    class Taxels,Proprio,Observation,History sense;
    class BestModel,Mode,Heads policy;
    class Safety safety;
    class Action action;
    class Teachers,Store,HBC,Eval learning;

    style World fill:#fffaf3,stroke:#f2b84b,stroke-width:2px,color:#3b2a12
    style Sensing fill:#f3f8ff,stroke:#7eb0ff,stroke-width:2px,color:#17324d
    style PolicyBlock fill:#fbf7ff,stroke:#b79cff,stroke-width:2px,color:#2f1d57
    style Training fill:#fbffe9,stroke:#b6e263,stroke-width:2px,color:#263a0a

    linkStyle 0,1,13,14,16 stroke:#f59e0b,stroke-width:2.6px
    linkStyle 2,3,4,15 stroke:#3b82f6,stroke-width:2.6px
    linkStyle 5,6,7,18 stroke:#8b5cf6,stroke-width:2.6px
    linkStyle 8 stroke:#10b981,stroke-width:3px
    linkStyle 9,10,11,17 stroke:#84cc16,stroke-width:2.6px
    linkStyle 12 stroke:#3574d6,stroke-width:2.8px
